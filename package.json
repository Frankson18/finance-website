{
  "name": "finance-website",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "npm run dev -w @fluxo/web",
    "build": "npm run build -w @fluxo/web",
    "api": "npm run dev -w @fluxo/api",
    "api:once": "npm run dev:once -w @fluxo/api",
    "stop": "fuser -k 3333/tcp 3000/tcp; echo servidores parados",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "npm run prisma:generate -w @fluxo/api",
    "db:migrate": "npm run prisma:migrate -w @fluxo/api",
    "db:deploy": "npm run prisma:deploy -w @fluxo/api",
    "db:studio": "npm run prisma:studio -w @fluxo/api"
  }
}
