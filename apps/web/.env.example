# URL da API para o proxy do Next (server-side). Padrão: http://localhost:3333
API_PROXY_URL="http://localhost:3333"

# Opcional: se definido, o cliente chama a API direto nessa URL (sem proxy).
# Em produção prefira o proxy (mesma origem) para cookies httpOnly funcionarem.
# NEXT_PUBLIC_API_URL=""

# hCaptcha (opcional) — sitekey pública. Necessária se o backend tiver CAPTCHA_SECRET.
# NEXT_PUBLIC_CAPTCHA_SITEKEY=""
