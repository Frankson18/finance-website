# Banco de dados (use o docker-compose na raiz: npm run db:up)
# A API conecta como `fluxo_app` (sem bypass de RLS). As migrations usam o dono (DIRECT_URL).
DATABASE_URL="postgresql://fluxo_app:fluxo_app_pw@localhost:5432/fluxo?schema=public"
DIRECT_URL="postgresql://fluxo:fluxo@localhost:5432/fluxo?schema=public"

# Segredo do JWT (troque por um valor longo e aleatório)
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-bem-grande"

# URLs
PORT=3333
API_URL="http://localhost:3333"
WEB_URL="http://localhost:3000"

# Origens permitidas no CORS (separadas por vírgula). Use "*" para liberar tudo (só em dev).
CORS_ORIGIN="http://localhost:3000"

# Google OAuth (opcional — deixe vazio para desativar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Verificação de senha vazada (Have I Been Pwned). "false" desativa.
PWNED_CHECK="true"

# Captcha (hCaptcha) — opcional. Preencha o secret para exigir captcha.
CAPTCHA_SECRET=""

# Criptografia em repouso dos campos de texto (AES-256-GCM). Gere com: openssl rand -base64 32
# Deixe vazio para desativar (dados em texto puro).
ENCRYPTION_KEY=""
