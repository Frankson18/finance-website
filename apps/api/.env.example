# Banco de dados (use o docker-compose na raiz: npm run db:up)
DATABASE_URL="postgresql://fluxo:fluxo@localhost:5432/fluxo?schema=public"

# Segredo do JWT (troque por um valor longo e aleatório)
JWT_SECRET="troque-este-segredo-por-um-valor-aleatorio-bem-grande"

# URLs
PORT=3333
API_URL="http://localhost:3333"
WEB_URL="http://localhost:3000"

# Google OAuth (opcional — deixe vazio para desativar)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
